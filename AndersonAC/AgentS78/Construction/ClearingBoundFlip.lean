import AndersonAC.S2.SignResampling

/-!
# Clearing first-failure bound (agent-s78clrbound): flip-stable null sets

The residual law of C4b (`Residual.clearingResidual_proof`, sign flips) compares a sample with
its images under whole-site flips `signFlip (flipSiteMask y)` and single-digit flips
`signFlip {inl (y, n)}`. If the trial's residuals are exact only off a null set `Z`, that
argument still applies off `Z` when `Z` is stable under these flips. `flipSat Z` is the
saturation of `Z` under the countable group they generate: it contains `Z`, is measurable, is
null when `Z` is, and is `FlipStable`.
-/

open MeasureTheory

noncomputable section
set_option autoImplicit false

namespace AndersonAC.AgentS78

open AndersonAC.S2 (RandomSources sourcesLaw SignIndex)
open AndersonAC.SolS2 (signFlip flipSigns)

variable {S : Type} [Fintype S] [DecidableEq S] {M : ℕ → ℕ}

/-- The sign indices of site `y` (the same set as `Residual.siteMask`, ClearingTrialResidual.lean;
restated here so that this file does not import ClearingTrialProof, whose
`exp_le_birthBound` clashes with TileTrialFirst's). -/
def flipSiteMask (S : Type) (y : S) : Set (SignIndex S) := {a | ∃ n, a = Sum.inl (y, n)}

/-- Measurable and stable under whole-site and single-digit sign flips. -/
def FlipStable (S : Type) [Fintype S] [DecidableEq S] {M : ℕ → ℕ}
    (Z : Set (RandomSources S M)) : Prop :=
  MeasurableSet Z ∧ (∀ (y : S) ω, signFlip S (flipSiteMask S y) ω ∈ Z ↔ ω ∈ Z) ∧
    (∀ (y : S) (n : ℕ) ω, signFlip S {Sum.inl (y, n)} ω ∈ Z ↔ ω ∈ Z)

theorem flipStable_empty : FlipStable S (∅ : Set (RandomSources S M)) :=
  ⟨MeasurableSet.empty, fun _ _ => Iff.rfl, fun _ _ _ => Iff.rfl⟩

/-- The digit mask of `(A, D)`: digit `(y, n)` is flipped iff exactly one of `y ∈ A`,
`(y, n) ∈ D` holds. -/
def flipMaskOf (p : Finset S × Finset (S × ℕ)) : Set (SignIndex S) :=
  {a | ∃ yn : S × ℕ, a = Sum.inl yn ∧ (yn.1 ∈ p.1 ↔ yn ∉ p.2)}

omit [Fintype S] [DecidableEq S] in
theorem mem_flipMaskOf_inl (p : Finset S × Finset (S × ℕ)) (yn : S × ℕ) :
    (Sum.inl yn : SignIndex S) ∈ flipMaskOf p ↔ (yn.1 ∈ p.1 ↔ yn ∉ p.2) := by
  constructor
  · rintro ⟨yn', h, hx⟩
    cases Sum.inl.inj h
    exact hx
  · intro h
    exact ⟨yn, rfl, h⟩

omit [Fintype S] [DecidableEq S] in
theorem not_mem_flipMaskOf_inr (p : Finset S × Finset (S × ℕ)) (k : ℕ) :
    (Sum.inr k : SignIndex S) ∉ flipMaskOf p := by
  simp [flipMaskOf]

omit [Fintype S] [DecidableEq S] in
theorem signFlip_signFlip (mask mask' : Set (SignIndex S)) (ω : RandomSources S M) :
    signFlip S mask (signFlip S mask' ω) = signFlip S (symmDiff mask mask') ω := by
  classical
  apply Prod.ext
  · funext a
    simp only [signFlip, flipSigns]
    by_cases h1 : a ∈ mask <;> by_cases h2 : a ∈ mask' <;>
      simp [h1, h2, Set.mem_symmDiff]
  · rfl

omit [Fintype S] [DecidableEq S] in
theorem signFlip_empty (ω : RandomSources S M) : signFlip S (∅ : Set (SignIndex S)) ω = ω := by
  classical
  apply Prod.ext
  · funext a
    simp [signFlip, flipSigns]
  · rfl

theorem flipMaskOf_empty : flipMaskOf (S := S) (∅, ∅) = ∅ := by
  ext a
  cases a with
  | inl yn => simp [mem_flipMaskOf_inl]
  | inr k => simp [not_mem_flipMaskOf_inr]

theorem flipMaskOf_site (p : Finset S × Finset (S × ℕ)) (y : S) :
    symmDiff (flipMaskOf p) (flipSiteMask S y) = flipMaskOf (symmDiff p.1 {y}, p.2) := by
  classical
  ext a
  cases a with
  | inl yn =>
    obtain ⟨y', n⟩ := yn
    have hs : (Sum.inl (y', n) : SignIndex S) ∈ flipSiteMask S y ↔ y' = y := by
      simp [flipSiteMask]
    rw [Set.mem_symmDiff, hs, mem_flipMaskOf_inl, mem_flipMaskOf_inl, Finset.mem_symmDiff,
      Finset.mem_singleton]
    tauto
  | inr k =>
    have hs : (Sum.inr k : SignIndex S) ∉ flipSiteMask S y := by simp [flipSiteMask]
    simp [Set.mem_symmDiff, hs, not_mem_flipMaskOf_inr]

theorem flipMaskOf_digit (p : Finset S × Finset (S × ℕ)) (y : S) (n : ℕ) :
    symmDiff (flipMaskOf p) {Sum.inl (y, n)} = flipMaskOf (p.1, symmDiff p.2 {(y, n)}) := by
  classical
  ext a
  cases a with
  | inl yn =>
    obtain ⟨y', n'⟩ := yn
    have hs : (Sum.inl (y', n') : SignIndex S) ∈ ({Sum.inl (y, n)} : Set (SignIndex S)) ↔
        (y', n') = (y, n) := by simp
    rw [Set.mem_symmDiff, hs, mem_flipMaskOf_inl, mem_flipMaskOf_inl, Finset.mem_symmDiff,
      Finset.mem_singleton]
    tauto
  | inr k =>
    simp [Set.mem_symmDiff, not_mem_flipMaskOf_inr]

/-- The saturation of `Z` under the flips generated by whole sites and single digits. -/
def flipSat (Z : Set (RandomSources S M)) : Set (RandomSources S M) :=
  ⋃ p : Finset S × Finset (S × ℕ), signFlip S (flipMaskOf p) ⁻¹' Z

theorem subset_flipSat (Z : Set (RandomSources S M)) : Z ⊆ flipSat Z := by
  intro ω hω
  refine Set.mem_iUnion.mpr ⟨(∅, ∅), ?_⟩
  show signFlip S (flipMaskOf (∅, ∅)) ω ∈ Z
  rw [flipMaskOf_empty, signFlip_empty]
  exact hω

theorem flipSat_measurable {Z : Set (RandomSources S M)} (hZ : MeasurableSet Z) :
    MeasurableSet (flipSat Z) :=
  MeasurableSet.iUnion fun p => AndersonAC.SolS2.signFlip_measurable S (flipMaskOf p) hZ

theorem flipSat_null {Z : Set (RandomSources S M)} (hZm : MeasurableSet Z)
    (hZ : sourcesLaw S M Z = 0) : sourcesLaw S M (flipSat Z) = 0 := by
  refine measure_iUnion_null fun p => ?_
  rw [← Measure.map_apply (AndersonAC.SolS2.signFlip_measurable S (flipMaskOf p)) hZm,
    AndersonAC.SolS2.signFlip_law]
  exact hZ

theorem flipSat_stable {Z : Set (RandomSources S M)} (hZm : MeasurableSet Z) :
    FlipStable S (flipSat Z) := by
  have key : ∀ (g : Set (SignIndex S)),
      (∀ p, ∃ p', symmDiff (flipMaskOf p) g = flipMaskOf p') →
      ∀ ω, ω ∈ flipSat Z → signFlip S g ω ∈ flipSat Z := by
    intro g hg ω hω
    obtain ⟨p, hp⟩ := Set.mem_iUnion.mp hω
    obtain ⟨p', hp'⟩ := hg p
    refine Set.mem_iUnion.mpr ⟨p', ?_⟩
    show signFlip S (flipMaskOf p') (signFlip S g ω) ∈ Z
    rw [signFlip_signFlip, ← hp', symmDiff_assoc, symmDiff_self, symmDiff_bot]
    exact hp
  have both : ∀ (g : Set (SignIndex S)),
      (∀ p, ∃ p', symmDiff (flipMaskOf p) g = flipMaskOf p') →
      ∀ ω, signFlip S g ω ∈ flipSat Z ↔ ω ∈ flipSat Z := by
    intro g hg ω
    constructor
    · intro h
      have := key g hg _ h
      rwa [AndersonAC.SolS2.signFlip_involutive S g ω] at this
    · exact key g hg ω
  refine ⟨flipSat_measurable hZm, fun y => both _ fun p => ⟨_, flipMaskOf_site p y⟩,
    fun y n => both _ fun p => ⟨_, flipMaskOf_digit p y n⟩⟩

end AndersonAC.AgentS78
